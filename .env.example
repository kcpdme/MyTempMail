# Comma-separated list of verified receiving domains (defaults; Settings portal can override)
DOMAINS=domain1.com,domain2.com

# Resend (https://resend.com/api-keys). Optional if you paste the key in Settings.
RESEND_API_KEY=re_xxxxxxxxx
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxx

# Public URL used to register the inbound webhook (also auto-set from VERCEL_URL)
APP_URL=https://your-app.vercel.app

# Upstash Redis REST credentials, or Vercel Marketplace KV_REST_API_* equivalents
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxx

# Message retention in seconds (default 24h)
INBOX_TTL_SECONDS=86400

# Max messages kept per inbox (oldest trimmed)
MAX_MESSAGES_PER_INBOX=50

# Password for /settings. Required in production. Optional in mock mode.
SETTINGS_SECRET=change-me

# Shared password for the inbox UI and APIs. If unset, anyone with the URL can
# read mail. The Resend webhook stays public either way so mail can be delivered.
ACCESS_PASSWORD=change-me-too

# Set to 1 to run fully locally: in-memory store, stubbed sends,
# /api/dev/seed enabled, DOMAINS defaults to example.test
MOCK_MODE=1
