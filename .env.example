# Comma-separated list of verified receiving domains (defaults; Settings portal can override)
DOMAINS=domain1.com,domain2.com

# Resend (https://resend.com/api-keys). Optional if you paste the key in Settings.
RESEND_API_KEY=re_xxxxxxxxx
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxx

# Public URL used to register the inbound webhook (also auto-set from VERCEL_URL)
APP_URL=https://your-app.vercel.app

# TursoDB database (server-only; never prefix these with NEXT_PUBLIC_).
# Run npm run db:setup after configuring the database.
TURSO_DATABASE_URL=turso://your-db.turso.io
TURSO_AUTH_TOKEN=your-database-token

# Vercel sends this as a Bearer token to the daily expiry-cleanup cron.
CRON_SECRET=replace-with-a-long-random-secret

# Set to 1 only while moving existing Redis data, then remove/redeploy.
STORAGE_MAINTENANCE=0

# Message retention in seconds (default 24h)
INBOX_TTL_SECONDS=86400

# Max messages kept per inbox (oldest trimmed)
MAX_MESSAGES_PER_INBOX=50

# Password for /settings. Required in production. Optional in mock mode.
SETTINGS_SECRET=change-me

# Shared password for the member workspace (inbox UI, compose, settings entry).
# If unset, anyone with the URL can read mail. Guests still need a per-inbox
# password created in the member UI. Guest passwords and sessions use
# the configured duration. The Resend webhook stays public so mail can be delivered.
ACCESS_PASSWORD=change-me-too

# Set to 1 to run fully locally: in-memory store, stubbed sends,
# /api/dev/seed enabled, DOMAINS defaults to example.test
MOCK_MODE=1
